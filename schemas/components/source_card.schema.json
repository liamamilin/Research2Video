{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "sources"
  ],
  "properties": {
    "title": {
      "const": "来源"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "domain",
          "date"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/autovideo/components/source_card.schema.json",
  "title": "AutoVideo source_card props v0.2"
}
