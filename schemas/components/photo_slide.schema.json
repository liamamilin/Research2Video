{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "photo_slide trusted props",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "text",
    "images"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_path",
          "image_asset_id"
        ],
        "properties": {
          "image_path": {
            "type": "string",
            "pattern": "^assets/slideshow/image-[0-9]{2}\\.png$"
          },
          "image_asset_id": {
            "type": "string",
            "pattern": "^slide_image_[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
