{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/autovideo/video-ir-v0.1.schema.json",
  "title": "AutoVideo Video IR 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video",
    "source",
    "style",
    "assets",
    "narration",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "width",
        "height",
        "fps",
        "duration_ms"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "fps": {
          "const": 30
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "text_sha256"
      ],
      "properties": {
        "language": {
          "const": "zh-CN"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "const": "minimal_dark"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "path",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "type": {
            "enum": [
              "audio",
              "image",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[a-zA-Z0-9_./-]+$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "audio_asset_id",
        "segments"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audio_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "start_ms",
              "end_ms"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_ms",
          "duration_ms",
          "component",
          "props",
          "narration_segment_ids",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 100
          },
          "component": {
            "enum": [
              "title_card",
              "concept_reveal",
              "flow_diagram",
              "comparison",
              "timeline",
              "bar_chart"
            ]
          },
          "props": {
            "type": "object"
          },
          "narration_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
