  "cues": [
    {
      "segment_id": "c1_n1",
      "text": "这张截图里，Pro 显示十七美元。",
      "char_start": 0,
      "char_end": 17,
      "start_ms": 360,
      "end_ms": 3094
    },
    {
      "segment_id": "c1_n2",
      "text": "下面还有一个条件：按年订阅，全年一次付二百美元；",
      "char_start": 0,
      "char_end": 24,
      "start_ms": 3574,
      "end_ms": 7927
    },
    {
      "segment_id": "c1_n3",
      "text": "按月支付则是二十美元。",
      "char_start": 0,
      "char_end": 11,
      "start_ms": 8367,
      "end_ms": 10430
    },
    {
      "segment_id": "c1_n4",
      "text": "看套餐价格时，要把付款周期一起看。",
      "char_start": 0,
      "char_end": 17,
      "start_ms": 10900,
      "end_ms": 13808
    }
  ],
