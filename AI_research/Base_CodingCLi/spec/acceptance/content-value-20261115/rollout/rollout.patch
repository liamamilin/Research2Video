+        {'id':'kept','item':{'url':URL}}, {'id':'unused','item':{'url':OTHER}}]})
+    assert json.loads(value.removeprefix('<!-- material-use: ').removesuffix(' -->')) == {
+        'selected':['kept'], 'background':[], 'deferred':['unused']}
