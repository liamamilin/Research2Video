    def test_slow_subscriber_retains_terminal_event_without_callback_errors():
        async def run():
            bus = LogBus("slow")
            q = bus.subscribe()
            errors = []
            asyncio.get_running_loop().set_exception_handler(lambda loop, context: errors.append(context))
            for number in range(q.maxsize + 10):
