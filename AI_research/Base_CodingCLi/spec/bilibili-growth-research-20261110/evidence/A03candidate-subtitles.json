      "from": 198.02,
      "to": 198.86,
      "sid": 106,
      "location": 2,
      "content": "随用随充",
      "music": 0.0
    },
    {
      "from": 198.86,
      "to": 201.08,
      "sid": 107,
      "location": 2,
      "content": "避免耗尽锂电池无记忆效应",
      "music": 0.0
    },
    {
      "from": 201.08,
      "to": 204.22,
      "sid": 108,
      "location": 2,
      "content": "电量降至20%到30%时充电即可",
      "music": 0.0
    },
    {
      "from": 204.22,
      "to": 205.4,
      "sid": 109,
      "location": 2,
      "content": "无需刻意放电",
      "music": 0.0
    },
    {
      "from": 205.4,
      "to": 206.82,
      "sid": 110,
      "location": 2,
      "content": "长期存放保留半电",
      "music": 0.0
    },
    {
      "from": 206.82,
      "to": 207.48,
      "sid": 111,
      "location": 2,
      "content": "若手机显示",
      "music": 0.0
    },
    {
      "from": 207.48,
      "to": 210.18,
      "sid": 112,
      "location": 2,
      "content": "保持电量在40%到60%",
      "music": 0.0
    },
    {
      "from": 210.18,
      "to": 212.66,
      "sid": 113,
      "location": 2,
      "content": "可最大限度减缓自放电导致的衰减",
      "music": 0.0
    },
    {
      "from": 212.66,
      "to": 214.12,
      "sid": 114,
      "location": 2,
      "content": "结余电池是工具",
      "music": 0.0
    },
    {
      "from": 214.12,
      "to": 215.32,
      "sid": 115,
      "location": 2,
      "content": "而非供奉的文物",
      "music": 0.0
    },
    {
      "from": 215.32,
      "to": 216.86,
      "sid": 116,
      "location": 2,
      "content": "科技媒体最终得出结论",
      "music": 0.0
    },
    {
      "from": 216.86,
      "to": 219.26,
      "sid": 117,
      "location": 2,
      "content": "80%充电限制带来的续航不便",
      "music": 0.0
    },
    {
      "from": 219.26,
      "to": 221.74,
      "sid": 118,
      "location": 2,
      "content": "远高于其对电池健康的微弱保护作用",
      "music": 0.0
    },
    {
      "from": 221.74,
      "to": 223.52,
      "sid": 119,
      "location": 2,
      "content": "当用户为了虚无的长期健康",
      "music": 0.0
    },
    {
      "from": 223.52,
      "to": 224.98,
      "sid": 120,
      "location": 2,
      "content": "牺牲日常使用体验时",
      "music": 0.0
    },
    {
      "from": 224.98,
      "to": 226.66,
      "sid": 121,
      "location": 2,
      "content": "Technology has failed its purpose",
      "music": 0.0
    },
    {
      "from": 226.66,
      "to": 228.08,
      "sid": 122,
      "location": 2,
      "content": "科技以背离其初衷",
      "music": 0.0
    },
    {
      "from": 228.08,
      "to": 229.76,
      "sid": 123,
      "location": 2,
      "content": "毕竟电池是消耗品",
      "music": 0.0
    },
    {
      "from": 229.76,
      "to": 231.12,
      "sid": 124,
      "location": 2,
      "content": "手机是服务人的工具",
      "music": 0.0
    },
    {
      "from": 231.12,
      "to": 232.68,
      "sid": 125,
      "location": 2,
      "content": "与其战战兢兢的省着用",
      "music": 0.0
    },
    {
      "from": 232.68,
      "to": 233.68,
      "sid": 126,
      "location": 2,
      "content": "不如敞开心态",
      "music": 0.0
    },
    {
      "from": 233.68,
      "to": 234.28,
      "sid": 127,
      "location": 2,
      "content": "放心用",
      "music": 0.0
    },
    {
      "from": 234.28,
      "to": 234.84,
      "sid": 128,
      "location": 2,
      "content": "两年后",
      "music": 0.0
    },
    {
      "from": 234.84,
      "to": 235.76,
      "sid": 129,
      "location": 2,
      "content": "若电池衰减",
      "music": 0.0
    },
    {
      "from": 235.76,
      "to": 237.06,
      "sid": 130,
      "location": 2,
      "content": "换一块电池的成本",
      "music": 0.0
    },
    {
      "from": 237.06,
      "to": 239.64,
      "sid": 131,
      "location": 2,
      "content": "远低于长期续航焦虑带来的精神损耗",
      "music": 0.0
    }
  ]
}
