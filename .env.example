# Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit it.

# Web UI JWT signing secret (production: long random string,
# generate with: openssl rand -hex 32)
AI_RESEARCH_SECRET_KEY="change-me-to-a-long-random-string"

# LLM provider key(s). Each provider preset in core/providers.py reads its
# key from its own var (set in ai.api_key_env / review_ai.api_key_env in
# system.yaml, auto-filled when you pick a provider in Settings), so you can
# keep several providers' keys here at once and switch between them without
# re-entering anything -- only the one named by api_key_env is read. Leave a
# provider's var empty/unset when not using it; a local endpoint such as
# Ollama needs no key at all (api_key_env: "").
OPENDESIGN_API_KEY=""     # Open Design (amr-link), preset id open-design
OPENCODE_API_KEY=""       # opencode Go/zen, preset id opencode-go / opencode-zen
DEEPSEEK_API_KEY=""       # DeepSeek official, preset id deepseek
OPENAI_API_KEY=""         # OpenAI official, preset id openai
# LLM_API_KEY is the legacy shared name: still read if ai.api_key_env or
# review_ai.api_key_env is explicitly set to it (e.g. an older config, or a
# custom base_url with no matching preset above).
LLM_API_KEY=""

# Web search API key (referenced by search.api_key_env in system.yaml).
# Parallel Search API: https://platform.parallel.ai
PARALLEL_API_KEY="your-parallel-api-key"
EXA_API_KEY=""            # Exa (exa.ai), search.provider: exa

# Optional: API key for the report cleanup pass (extraction.enabled=true)
EXTRACTION_API_KEY=""

# Optional: SMTP password for email notifications
# (referenced by notifications.email.smtp_password_env in system.yaml)
SMTP_PASSWORD=""

# Optional: notification webhooks (referenced by
# notifications.<channel>.webhook_url_env in system.yaml)
WECOM_WEBHOOK_URL=""
FEISHU_WEBHOOK_URL=""
FEISHU_BOT_SECRET=""
NOTIFY_WEBHOOK_URL=""

# Optional: push straight to personal WeChat (pick either one)
PUSHPLUS_TOKEN=""
SERVERCHAN_SENDKEY=""
