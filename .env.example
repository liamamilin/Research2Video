# Copy to .env and enter your DeepSeek API key. Keep .env private (chmod 600 .env).
DEEPSEEK_API_KEY=

# Optional: use another model service (OpenAI chat-completions protocol) instead of DeepSeek. Details: g2/llm_provider.py
# AUTOVIDEO_LLM_PROVIDER=opendesign        # deepseek (default) | opencode | opendesign | custom
# AUTOVIDEO_LLM_ENV_FILE=/path/to/other/.env   # read that provider's key from a file that already has it, instead of copying it here
# AUTOVIDEO_LLM_MODEL=                     # any of the provider's settings can be overridden: _BASE_URL _API_KEY_ENV _MAX_TOKENS _INPUT_PER_M _OUTPUT_PER_M _THINKING _JSON_MODE
