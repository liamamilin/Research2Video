  "model_sha256": "be19ef8ac4326d032e7673342930b14c2df30bd68c1632493b0f563e30829f91",
  "generation_seconds": 2.997,
  "cues": [
    {
      "segment_id": "c1_n1",
      "text": "我把椅子往窗边挪了挪。",
      "char_start": 0,
      "char_end": 11,
      "start_ms": 440,
      "end_ms": 2186
    },
    {
      "segment_id": "c1_n2",
      "text": "雨刚停，屋檐还在滴水，一滴落下去，另一滴才慢慢聚拢。",
      "char_start": 0,
      "char_end": 26,
      "start_ms": 2556,
      "end_ms": 7270
    },
    {
      "segment_id": "c1_n3",
      "text": "院子里的树没有说话，",
      "char_start": 0,
      "char_end": 10,
      "start_ms": 7830,
      "end_ms": 9480
    },
    {
      "segment_id": "c1_n3",
      "text": "叶尖却像藏着许多尚未说完的句子。",
      "char_start": 10,
      "char_end": 26,
      "start_ms": 9670,
      "end_ms": 12520
    },
    {
      "segment_id": "c1_n4",
      "text": "桌上那杯茶早已凉了。",
      "char_start": 0,
      "char_end": 10,
      "start_ms": 13286,
      "end_ms": 15046
    },
    {
      "segment_id": "c1_n5",
      "text": "我端起来，又放下。",
      "char_start": 0,
      "char_end": 9,
      "start_ms": 15632,
      "end_ms": 16912
    },
    {
      "segment_id": "c1_n6",
      "text": "今天没有非读完不可的书，也没有非赶上的一班车。",
      "char_start": 0,
      "char_end": 23,
      "start_ms": 17340,
      "end_ms": 21150
    },
    {
      "segment_id": "c1_n7",
      "text": "风从窗缝里进来，把摊开的书页翻过一张，",
      "char_start": 0,
      "char_end": 19,
      "start_ms": 21634,
      "end_ms": 24964
    },
    {
      "segment_id": "c1_n7",
      "text": "停在我昨天留下折角的地方。",
      "char_start": 19,
      "char_end": 32,
      "start_ms": 25154,
      "end_ms": 27334
    },
    {
      "segment_id": "c1_n8",
      "text": "远处有人推着自行车经过，车轮轻轻碾过积水。",
      "char_start": 0,
      "char_end": 21,
      "start_ms": 28114,
      "end_ms": 32038
    },
    {
      "segment_id": "c1_n9",
      "text": "我听见那点声响，忽然想起小时候放学的路。",
      "char_start": 0,
      "char_end": 20,
      "start_ms": 32518,
      "end_ms": 35688
    },
    {
      "segment_id": "c1_n10",
      "text": "那时我们总绕开大路，踩着湿漉漉的石板回家，",
      "char_start": 0,
      "char_end": 21,
      "start_ms": 36318,
      "end_ms": 39568
    },
    {
      "segment_id": "c1_n10",
      "text": "仿佛慢一点，傍晚就能长一点。",
      "char_start": 21,
      "char_end": 35,
      "start_ms": 39598,
      "end_ms": 41648
    },
    {
      "segment_id": "c1_n11",
      "text": "天色渐渐暗下来。",
      "char_start": 0,
      "char_end": 8,
      "start_ms": 42649,
      "end_ms": 44159
    },
    {
      "segment_id": "c1_n12",
      "text": "我没有开灯，只把杯子移到一旁，给书腾出一点地方。",
      "char_start": 0,
      "char_end": 24,
      "start_ms": 44639,
      "end_ms": 48312
    },
    {
      "segment_id": "c1_n13",
      "text": "窗外最后一滴雨水落下时，我觉得，",
      "char_start": 0,
      "char_end": 16,
      "start_ms": 48792,
      "end_ms": 51802
    },
    {
      "segment_id": "c1_n13",
      "text": "今天也可以这样过去：没有什么特别的收获，",
      "char_start": 16,
      "char_end": 36,
      "start_ms": 51802,
      "end_ms": 54802
    },
    {
      "segment_id": "c1_n13",
      "text": "却把自己好好地安放了一会儿。",
      "char_start": 36,
      "char_end": 50,
      "start_ms": 54802,
      "end_ms": 56555
    }
  ],
