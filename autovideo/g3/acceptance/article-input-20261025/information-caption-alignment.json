  "model_sha256": "be19ef8ac4326d032e7673342930b14c2df30bd68c1632493b0f563e30829f91",
  "generation_seconds": 2.722,
  "cues": [
    {
      "segment_id": "c1_n1",
      "text": "水一定要烧开，才会变成水蒸气吗？",
      "char_start": 0,
      "char_end": 16,
      "start_ms": 310,
      "end_ms": 2527
    },
    {
      "segment_id": "c1_n2",
      "text": "不一定。",
      "char_start": 0,
      "char_end": 4,
      "start_ms": 2981,
      "end_ms": 3413
    },
    {
      "segment_id": "c1_n3",
      "text": "蒸发，指的是液态水转变为气态水的过程。",
      "char_start": 0,
      "char_end": 19,
      "start_ms": 3899,
      "end_ms": 6574
    },
    {
      "segment_id": "c1_n4",
      "text": "常压下，水的沸点约为100摄氏度，",
      "char_start": 0,
      "char_end": 17,
      "start_ms": 6870,
      "end_ms": 8910
    },
    {
      "segment_id": "c1_n4",
      "text": "但蒸发并不只发生在沸点。",
      "char_start": 17,
      "char_end": 29,
      "start_ms": 8910,
      "end_ms": 10482
    },
    {
      "segment_id": "c1_n5",
      "text": "温度较低时，水也能蒸发，只是速度通常更慢。",
      "char_start": 0,
      "char_end": 21,
      "start_ms": 10888,
      "end_ms": 13796
    },
    {
      "segment_id": "c2_n1",
      "text": "蒸发需要能量，因此会带走周围环境的一部分热量。",
      "char_start": 0,
      "char_end": 23,
      "start_ms": 14595,
      "end_ms": 17585
    },
    {
      "segment_id": "c2_n2",
      "text": "这也是蒸发式冷却的原理。",
      "char_start": 0,
      "char_end": 12,
      "start_ms": 17991,
      "end_ms": 19536
    },
    {
      "segment_id": "c2_n3",
      "text": "不过，效果会受到环境湿度等条件影响，",
      "char_start": 0,
      "char_end": 18,
      "start_ms": 19878,
      "end_ms": 22248
    },
    {
      "segment_id": "c2_n3",
      "text": "较干燥的环境更适合使用这种方式。",
      "char_start": 18,
      "char_end": 34,
      "start_ms": 22438,
      "end_ms": 24648
    },
    {
      "segment_id": "c2_n4",
      "text": "在潮湿环境里，不能直接照搬同样的降温预期，",
      "char_start": 0,
      "char_end": 21,
      "start_ms": 24992,
      "end_ms": 27842
    },
    {
      "segment_id": "c2_n4",
      "text": "更不能由此推断所有房间都可以不用常规空调。",
      "char_start": 21,
      "char_end": 42,
      "start_ms": 27872,
      "end_ms": 30962
    },
    {
      "segment_id": "c3_n1",
      "text": "蒸发也参与自然界的水循环，使水从地表进入大气。",
      "char_start": 0,
      "char_end": 23,
      "start_ms": 31875,
      "end_ms": 35377
    },
    {
      "segment_id": "c3_n2",
      "text": "凝结则是相反的变化：水蒸气重新变成液态水。",
      "char_start": 0,
      "char_end": 21,
      "start_ms": 35783,
      "end_ms": 39141
    },
    {
      "segment_id": "c3_n3",
      "text": "理解这两个方向，就能把杯子里的水逐渐减少，",
      "char_start": 0,
      "char_end": 21,
      "start_ms": 39547,
      "end_ms": 42237
    },
    {
      "segment_id": "c3_n3",
      "text": "与空气中的水重新形成水滴联系起来。",
      "char_start": 21,
      "char_end": 38,
      "start_ms": 42347,
      "end_ms": 44787
    }
  ],
