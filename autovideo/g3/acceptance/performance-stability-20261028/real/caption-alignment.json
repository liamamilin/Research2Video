  "cues": [
    {
      "segment_id": "c1_n1",
      "text": "视频从写稿进入制作时，页面需要继续更新。",
      "char_start": 0,
      "char_end": 20,
      "start_ms": 360,
      "end_ms": 3957
    },
    {
      "segment_id": "c1_n2",
      "text": "正在工作的任务显示进度，",
      "char_start": 0,
      "char_end": 12,
      "start_ms": 4437,
      "end_ms": 6487
    },
    {
      "segment_id": "c1_n2",
      "text": "完成之后显示可以播放的成片。",
      "char_start": 12,
      "char_end": 26,
      "start_ms": 6597,
      "end_ms": 8807
    },
    {
      "segment_id": "c2_n1",
      "text": "长文稿可以分成独立章节。",
      "char_start": 0,
      "char_end": 12,
      "start_ms": 9781,
      "end_ms": 12071
    },
    {
      "segment_id": "c2_n2",
      "text": "如果后面的配音失败，已经完成的章节应当保留，",
      "char_start": 0,
      "char_end": 22,
      "start_ms": 12480,
      "end_ms": 15810
    },
    {
      "segment_id": "c2_n2",
      "text": "重试时继续生成剩下的内容。",
      "char_start": 22,
      "char_end": 35,
      "start_ms": 15810,
      "end_ms": 18050
    }
  ],
