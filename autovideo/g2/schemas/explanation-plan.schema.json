          "component",
          "props"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "enum": [
              "title_card",
              "concept_reveal",
              "comparison",
              "big_number",
              "bar_chart",
              "price_change",
              "data_chart",
              "scatter_chart",
              "flow_diagram"
            ]
          },
          "props": {
            "type": "object"
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "material_cues": {
