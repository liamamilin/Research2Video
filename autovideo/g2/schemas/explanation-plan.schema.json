              "required": [
                "image_index",
                "phrase"
              ],
              "properties": {
                "image_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                "region_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "phrase": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          },
          "material_summary_phrase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "story_role": {
