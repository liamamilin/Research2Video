              "compare",
              "result",
              "bridge",
              "recap"
            ]
          },
          "importance": {
            "enum": [
              "key",
              "normal",
              "support"
            ]
          },
          "entities": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "targets": {
                  "type": "array",
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
