{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pages"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "props"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "enum": [
              "title_card",
              "concept_reveal",
              "comparison",
              "big_number",
              "bar_chart",
              "price_change",
              "data_chart",
              "scatter_chart",
              "flow_diagram"
            ]
          },
          "props": {
            "type": "object"
          },
          "material_cues": {
            "type": "array", "maxItems": 48,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["image_index", "phrase"],
              "properties": {
                "image_index": {"type": "integer", "minimum": 0, "maximum": 11},
                "region_index": {"type": "integer", "minimum": 0, "maximum": 2},
                "phrase": {"type": "string", "minLength": 1, "maxLength": 80}
              }
            }
          },
          "material_summary_phrase": {
            "type": "string", "minLength": 1, "maxLength": 80
          }
        }
      }
    }
  }
}
