{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "chapters"
  ],
  "properties": {
    "mode": {
      "const": "content"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "narration_segment_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[1-9][0-9]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "narration_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
