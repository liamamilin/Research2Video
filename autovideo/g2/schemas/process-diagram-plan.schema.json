{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unsupported_reason",
    "scenes"
  ],
  "properties": {
    "unsupported_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 300
    },
    "scenes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "takeaway",
          "narration_segment_ids",
          "nodes",
          "edges",
          "cues"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "takeaway": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "narration_segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "source_quote"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 30
                },
                "source_quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            },
            "maxItems": 8
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "from",
                "to",
                "label",
                "source_quote"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 12
                },
                "source_quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "relation": {
                  "enum": [
                    "flow",
                    "blocked"
                  ]
                }
              }
            },
            "maxItems": 16
          },
          "cues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "quote",
                "node_ids",
                "edge_ids"
              ],
              "properties": {
                "segment_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "node_ids": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "edge_ids": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                }
              }
            }
          },
          "visuals": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target",
                "icon"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^(line:[0-3]|side:(left|right)|node:[a-z][a-z0-9_]{0,47})$"
                },
                "icon": {
                  "enum": [
                    "database",
                    "server",
                    "file",
                    "folder",
                    "search",
                    "user",
                    "users",
                    "clock",
                    "cost",
                    "cloud",
                    "code",
                    "network",
                    "chart",
                    "brain",
                    "cpu",
                    "shield",
                    "globe",
                    "book",
                    "leaf",
                    "atom",
                    "building",
                    "settings",
                    "result"
                  ]
                },
                "action": {
                  "enum": [
                    "none",
                    "send",
                    "process",
                    "complete",
                    "disconnect"
                  ]
                },
                "phrase": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      }
    }
  }
}
