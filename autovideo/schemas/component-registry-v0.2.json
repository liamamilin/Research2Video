{
  "registry_version": "0.2",
  "notes": "target patterns are declarative; semantic validation must prove every target exists in component props and the action is supported. A token like line:* means a numeric index; path:* means declared path id.",
  "components": {
    "title_card": {
      "props_schema": "components/title_card.schema.json",
      "actions": {
        "reveal": [
          "scene",
          "title",
          "subtitle"
        ],
        "emphasize": [
          "title",
          "subtitle"
        ],
        "hide": [
          "scene",
          "title",
          "subtitle"
        ]
      }
    },
    "concept_reveal": {
      "props_schema": "components/concept_reveal.schema.json",
      "actions": {
        "reveal": [
          "scene",
          "title",
          "line:*"
        ],
        "highlight": [
          "line:*",
          "title"
        ],
        "hide": [
          "scene",
          "line:*"
        ]
      }
    },
    "flow_diagram": {
      "props_schema": "components/flow_diagram.schema.json",
      "actions": {
        "reveal": [
          "scene",
          "node:*",
          "edge:*"
        ],
        "highlight": [
          "node:*",
          "edge:*"
        ],
        "activate_path": [
          "path:*"
        ],
        "mark_disrupted": [
          "edge:*"
        ]
      }
    },
    "comparison": {
      "props_schema": "components/comparison.schema.json",
      "actions": {
        "reveal": [
          "scene",
          "side:left",
          "side:right"
        ],
        "highlight": [
          "side:left",
          "side:right"
        ],
        "emphasize_difference": [
          "diff"
        ]
      }
    },
    "timeline": {
      "props_schema": "components/timeline.schema.json",
      "actions": {
        "reveal": [
          "scene",
          "event:*"
        ],
        "highlight": [
          "event:*"
        ]
      }
    },
    "bar_chart": {
      "props_schema": "components/bar_chart.schema.json",
      "actions": {
        "reveal": [
          "scene",
          "bar:*"
        ],
        "highlight": [
          "bar:*"
        ]
      }
    }
  }
}
