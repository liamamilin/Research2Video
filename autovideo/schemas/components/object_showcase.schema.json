{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "object_showcase trusted image material props",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "text",
    "images",
    "focus_indices"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_path",
          "image_asset_id",
          "caption",
          "role"
        ],
        "properties": {
          "image_path": {
            "type": "string",
            "pattern": "^assets/slideshow/image-[0-9]{2}\\.png$"
          },
          "image_asset_id": {
            "type": "string",
            "pattern": "^slide_image_[1-9][0-9]*$"
          },
          "caption": {
            "type": "string",
            "maxLength": 80
          },
          "role": {
            "enum": [
              "reference",
              "overall",
              "detail",
              "comparison"
            ]
          },
          "focus": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "regions"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 128,
                "maximum": 8192
              },
              "height": {
                "type": "integer",
                "minimum": 128,
                "maximum": 8192
              },
              "regions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x1",
                    "y1",
                    "x2",
                    "y2"
                  ],
                  "properties": {
                    "x1": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "y1": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "x2": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "y2": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 32,
                      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
                    },
                    "style": {
                      "enum": [
                        "box",
                        "circle",
                        "underline",
                        "highlight"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "focus_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 11
      }
    }
  }
}
