          }
        },
        "dependentRequired": {
          "change": [
            "direction"
          ],
          "direction": [
            "change"
          ]
        }
      }
    },
    "staged": {
      "const": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
