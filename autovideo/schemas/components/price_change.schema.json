            "minLength": 1,
            "maxLength": 10
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "\\d"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "\\d"
          },
