{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "lines"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 24},
    "label": {"type": "string", "maxLength": 40},
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\r\\n]+$"},
          "phrase": {"type": "string", "minLength": 1, "maxLength": 80},
          "annotation": {"type": "string", "maxLength": 60},
          "change": {"enum": ["keep", "add", "remove"]}
        }
      }
    }
  }
}
