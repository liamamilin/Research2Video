{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "segments"
  ],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_quotes",
          "point_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 80
          },
          "source_quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "point_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^p[1-9][0-9]*$"
            }
          }
        }
      }
    }
  }
}
