{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoVideo StoryboardPlan G2 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "props",
          "narration_segment_ids",
          "purpose",
          "visual_intent",
          "beats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "component": {
            "enum": [
              "title_card",
              "concept_reveal",
              "flow_diagram",
              "comparison",
              "timeline",
              "bar_chart"
            ]
          },
          "props": {
            "type": "object"
          },
          "narration_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^n[1-9][0-9]*$"
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "visual_intent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "viewer_understands",
              "before",
              "after"
            ],
            "properties": {
              "viewer_understands": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "action",
                "target_id",
                "trigger"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "action": {
                  "enum": [
                    "reveal",
                    "highlight",
                    "hide",
                    "emphasize",
                    "activate_path",
                    "mark_disrupted",
                    "emphasize_difference"
                  ]
                },
                "target_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "trigger": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment_id",
                    "boundary",
                    "offset_ms"
                  ],
                  "properties": {
                    "segment_id": {
                      "type": "string",
                      "pattern": "^n[1-9][0-9]*$"
                    },
                    "boundary": {
                      "enum": [
                        "start",
                        "end"
                      ]
                    },
                    "offset_ms": {
                      "type": "integer",
                      "minimum": -1000,
                      "maximum": 1000
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
