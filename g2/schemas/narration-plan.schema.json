{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoVideo NarrationPlan G2 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "core_message", "necessary_points", "omissions", "ambiguities", "segments"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 46},
    "core_message": {"type": "string", "minLength": 8, "maxLength": 180},
    "necessary_points": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["point", "source_quotes"],
        "properties": {
          "point": {"type": "string", "minLength": 3, "maxLength": 100},
          "source_quotes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 3, "maxLength": 120}}
        }
      }
    },
    "omissions": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
    "ambiguities": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
    "segments": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "source_quotes"],
        "properties": {
          "id": {"type": "string", "pattern": "^n[1-6]$"},
          "text": {"type": "string", "minLength": 8, "maxLength": 80},
          "source_quotes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 3, "maxLength": 120}}
        }
      }
    }
  }
}
