{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoVideo controlled visual narrative experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "takeaway",
          "source_quotes",
          "narration_segment_ids",
          "objects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "takeaway": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          },
          "source_quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "narration_segment_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
            }
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "x",
                "y"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
                },
                "kind": {
                  "enum": [
                    "group",
                    "sphere",
                    "ellipse",
                    "rect",
                    "arrow",
                    "wave",
                    "marker",
                    "text"
                  ]
                },
                "parent_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
                },
                "x": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "width": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 100
                },
                "height": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 100
                },
                "rotation": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "color": {
                  "enum": [
                    "blue",
                    "cyan",
                    "gold",
                    "green",
                    "purple",
                    "red",
                    "white",
                    "slate"
                  ]
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "surface": {
                  "enum": [
                    "earth",
                    "moon",
                    "sun",
                    "plain"
                  ]
                },
                "label": {
                  "type": "string",
                  "maxLength": 32
                },
                "label_position": {
                  "enum": [
                    "above",
                    "below",
                    "left",
                    "right",
                    "none"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 60
                },
                "motion": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "rotate",
                        "orbit",
                        "translate",
                        "pulse",
                        "wave",
                        "fade_in",
                        "oscillate"
                      ]
                    },
                    "degrees": {
                      "type": "number",
                      "minimum": -720,
                      "maximum": 720
                    },
                    "dx": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100
                    },
                    "dy": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100
                    },
                    "center_x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "center_y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "cycles": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 6
                    },
                    "amplitude": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.4
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
