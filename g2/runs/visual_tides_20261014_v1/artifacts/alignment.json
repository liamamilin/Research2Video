      "end_ms": 3037
    },
    {
      "id": "n2",
      "text": "地球上的海水受到月球引力作用，同时地球和月球围绕共同质心运动产生的惯性作用，使地球两侧的海水都倾向形成隆起。月球引力会影响潮汐。",
      "utterance_start_sample": 86544,
      "utterance_end_sample": 375920,
      "speech_first_sample": 1171,
      "speech_last_sample": 283320,
      "sample_rate": 24000,
      "voice": "zf_xiaoxiao",
      "wav": "g3/data/jobs/877e83a6-b9a7-41b2-a433-22a847a4e97c/attempts/1/g2-run/fixtures/assets/segments/n2.wav",
      "start_ms": 3606,
      "end_ms": 15461
    },
    {
      "id": "n3",
      "text": "地球自转使许多海岸地区依次经过不同的海面高度，因此通常一天会出现两次涨潮和两次落潮，但具体次数和时间会随地点而不同。",
      "utterance_start_sample": 384560,
      "utterance_end_sample": 657408,
      "speech_first_sample": 1021,
      "speech_last_sample": 266781,
      "sample_rate": 24000,
      "voice": "zf_xiaoxiao",
      "wav": "g3/data/jobs/877e83a6-b9a7-41b2-a433-22a847a4e97c/attempts/1/g2-run/fixtures/assets/segments/n3.wav",
      "start_ms": 16023,
      "end_ms": 27189
    },
    {
      "id": "n4",
      "text": "太阳的引力也会影响潮汐。当地球、月球、太阳大致排成一线时，太阳和月球的潮汐作用方向接近，潮差通常较大，称为大潮。",
      "utterance_start_sample": 666048,
      "utterance_end_sample": 919552,
      "speech_first_sample": 935,
      "speech_last_sample": 247426,
      "sample_rate": 24000,
      "voice": "zf_xiaoxiao",
      "wav": "g3/data/jobs/877e83a6-b9a7-41b2-a433-22a847a4e97c/attempts/1/g2-run/fixtures/assets/segments/n4.wav",
      "start_ms": 27752,
      "end_ms": 38111
    },
    {
      "id": "n5",
      "text": "当月球与太阳相对地球大致成直角时，两者作用部分抵消，潮差通常较小，称为小潮。",
      "utterance_start_sample": 928192,
      "utterance_end_sample": 1108303,
      "speech_first_sample": 917,
      "speech_last_sample": 174349,
      "sample_rate": 24000,
      "voice": "zf_xiaoxiao",
      "wav": "g3/data/jobs/877e83a6-b9a7-41b2-a433-22a847a4e97c/attempts/1/g2-run/fixtures/assets/segments/n5.wav",
      "start_ms": 38675,
      "end_ms": 45989
    },
    {
      "id": "n6",
      "text": "海岸的形状、水深和海底地形会进一步改变潮汐传播，因此不同海湾的潮汐时间与高度并不完全相同。潮汐是海水整体运动，不等于每一处海面都以同样方式升降。",
      "utterance_start_sample": 1116943,
